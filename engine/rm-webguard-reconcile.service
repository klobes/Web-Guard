[Unit]
Description=Reconcile owned temporary RM WebGuard Cloudflare bans
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/rm-webguard/cf_action.py reconcile
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rm-webguard
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
